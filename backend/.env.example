GROQ_API_KEY=your_groq_api_key
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
TAVILY_API_KEY=your_tavily_api_key

# Optional — only needed if you want to enable model switching to these
# providers (see settings.AVAILABLE_MODELS in app/core/config.py and
# GET /api/models). Leave blank/unset to keep those models unavailable.
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional — defaults shown
SUPABASE_CASES_TABLE=decision_cases
API_HOST=0.0.0.0
API_PORT=8000
